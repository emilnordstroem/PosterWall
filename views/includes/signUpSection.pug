div#userSignUpSection
    label(for="username") Username:
    input.signupInput(type="text", name="username" required)
    
    label(for="email") Email:
    input.signupInput(type="email", name="email" required)
    
    label(for="dateOfBirth") Date of Birth:
    input.signupInput(type="date", name="dateOfBirth" required)
    
    label(for="password") Password:
    input.signupInput(type="password", name="password" required)
    
    button#signUpButton(type="button") Sign Up
